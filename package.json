{
  "name": "n8n-nodes-sequenzy",
  "version": "1.1.2",
  "description": "Sequenzy is an email platform for SaaS companies to send lifecycle emails, email campaigns, and transactional emails",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://sequenzy.com",
  "author": {
    "name": "Sequenzy",
    "email": "support@sequenzy.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sequenzy/n8n-nodes-sequenzy.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "test": "bun test ../n8n-nodes-sequenzy-tests",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier nodes credentials --write",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SequenzyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Sequenzy/Sequenzy.node.js",
      "dist/nodes/SequenzyTrigger/SequenzyTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.54.5",
    "@types/node": "^26.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
